import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import yfinance as yf

from sklearn.model_selection import train_test_split
from sklearn.linear_model import LinearRegression
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error

from statsmodels.tsa.arima.model import ARIMA

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense
from sklearn.preprocessing import MinMaxScaler

data = yf.download("AAPL", start="2015-01-01", end="2024-01-01")
data = data[['Close']]
data.dropna(inplace=True)

print(data.head())

plt.figure(figsize=(10,5))
plt.plot(data['Close'])
plt.title("Stock Closing Price")
plt.show()

data['Prev_Close'] = data['Close'].shift(1)
data.dropna(inplace=True)

X = data[['Prev_Close']]
y = data['Close']

X_train, X_test, y_train, y_test = train_test_split(X, y, shuffle=False, test_size=0.2)

lr = LinearRegression()
lr.fit(X_train, y_train)

lr_pred = lr.predict(X_test)

print("Linear Regression MSE:", mean_squared_error(y_test, lr_pred))

rf = RandomForestRegressor(n_estimators=100)
rf.fit(X_train, y_train)

rf_pred = rf.predict(X_test)

print("Random Forest MSE:", mean_squared_error(y_test, rf_pred))

model = ARIMA(data['Close'], order=(5,1,0))
model_fit = model.fit()

arima_pred = model_fit.forecast(steps=len(X_test))

print("ARIMA MSE:", mean_squared_error(y_test, arima_pred))

scaler = MinMaxScaler()
scaled_data = scaler.fit_transform(data[['Close']])

def create_dataset(data, time_step=60):
    X, y = [], []
    for i in range(len(data)-time_step-1):
        X.append(data[i:(i+time_step), 0])
        y.append(data[i+time_step, 0])
    return np.array(X), np.array(y)

time_step = 60
X_lstm, y_lstm = create_dataset(scaled_data, time_step)

X_lstm = X_lstm.reshape(X_lstm.shape[0], X_lstm.shape[1], 1)

train_size = int(len(X_lstm)*0.8)

X_train_lstm = X_lstm[:train_size]
X_test_lstm = X_lstm[train_size:]

y_train_lstm = y_lstm[:train_size]
y_test_lstm = y_lstm[train_size:]

model = Sequential()
model.add(LSTM(50, return_sequences=True, input_shape=(60,1)))
model.add(LSTM(50))
model.add(Dense(1))

model.compile(loss='mean_squared_error', optimizer='adam')

model.fit(X_train_lstm, y_train_lstm, epochs=5, batch_size=32)

lstm_pred = model.predict(X_test_lstm)
lstm_pred = scaler.inverse_transform(lstm_pred)

y_test_actual = scaler.inverse_transform(y_test_lstm.reshape(-1,1))

print("LSTM MSE:", mean_squared_error(y_test_actual, lstm_pred))

print("LR:", mean_squared_error(y_test, lr_pred))
print("RF:", mean_squared_error(y_test, rf_pred))
print("ARIMA:", mean_squared_error(y_test, arima_pred))
print("LSTM:", mean_squared_error(y_test_actual, lstm_pred))

plt.figure(figsize=(12,6))
plt.plot(y_test.values, label="Actual")
plt.plot(lr_pred, label="Linear Regression")
plt.plot(rf_pred, label="Random Forest")
plt.legend()
plt.show()
