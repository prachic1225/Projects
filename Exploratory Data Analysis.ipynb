       "description        0\n",
       "year_added        88\n",
       "month_added       88\n",
       "age_on_netflix    88\n",
       "dtype: int64"
      ]
     },
     "execution_count": 53,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# 2. Handle missing values in 'country'\n",
    "# We will fill these values with the mode, which is the most common country.\n",
    "mode_country = netflix_df['country'].mode()[0]\n",
    "netflix_df['country'] = netflix_df['country'].fillna(mode_country)\n",
    "netflix_df.isnull().sum()"
   ]
  },
